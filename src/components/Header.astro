---
const navigation = [
  { label: 'Experience', href: '#experience' },
  { label: 'Focus', href: '#focus' },
  { label: 'Technologies', href: '#technologies' },
  { label: 'Projects', href: '#projects' },
  { label: 'Education', href: '#certifications' },
  { label: 'About me', href: '#about' },
  { label: 'Contact', href: '#contact' }
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#0b0f0e]/90 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="group flex shrink-0 items-center gap-3" aria-label="QuantumKoga home">
      <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-emerald-400/30 bg-emerald-400/[0.08] font-mono text-sm font-semibold text-emerald-300 transition group-hover:border-emerald-400/60">
        QK
      </span>
      <span class="text-sm font-semibold tracking-wide text-white">QuantumKoga</span>
    </a>

    <nav class="hidden items-center gap-x-5 gap-y-2 lg:flex" aria-label="Main navigation">
      {navigation.map((item) => (
        <a
          href={item.href}
          class="whitespace-nowrap text-xs font-medium text-[#a4b0a8] transition hover:text-emerald-300"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <details class="relative lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-lg border border-white/15 px-3 py-2 text-sm font-medium text-[#d5ded8] transition hover:border-emerald-400/40 hover:text-emerald-300 [&::-webkit-details-marker]:hidden"
        aria-label="Toggle navigation menu"
      >
        <span>Menu</span>
        <svg
          class="h-4 w-4 transition-transform duration-200"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>

      <nav
        class="absolute right-0 top-[calc(100%+0.75rem)] z-50 w-64 rounded-xl border border-white/10 bg-[#101613] p-2 shadow-2xl shadow-black/40"
        aria-label="Mobile navigation"
      >
        {navigation.map((item) => (
          <a
            href={item.href}
            class="block rounded-lg px-4 py-3 text-sm text-[#b8c4bc] transition hover:bg-emerald-400/[0.07] hover:text-emerald-300"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const mobileMenu = document.querySelector('header details');

  mobileMenu?.querySelectorAll('nav a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.removeAttribute('open');
    });
  });
</script>

<style>
  details[open] summary svg {
    transform: rotate(180deg);
  }
</style>